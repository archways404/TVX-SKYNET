          "rawQuery": true,
          "rawSql": "SELECT source.name AS \"Provider\", component.name AS \"Component\",\n CASE MAX(CASE component.current_status WHEN 'operational' THEN 0 WHEN 'maintenance' THEN 1\n  WHEN 'unknown' THEN 2 WHEN 'degraded' THEN 3 WHEN 'partial_outage' THEN 4 WHEN 'major_outage' THEN 5 ELSE 2 END)\n WHEN 0 THEN 'operational' WHEN 1 THEN 'maintenance' WHEN 2 THEN 'unknown'\n WHEN 3 THEN 'degraded' WHEN 4 THEN 'partial_outage' ELSE 'major_outage' END AS \"Status\",\n COUNT(*) AS \"Reported instances\", MAX(component.provider_updated_at) AS \"Provider updated\"\nFROM external_status.components component JOIN external_status.sources source ON source.id = component.provider_id\nWHERE source.enabled AND component.active AND component.provider_id ~ '^${provider:regex}$'\nGROUP BY source.name, component.name\nORDER BY MAX(CASE component.current_status WHEN 'operational' THEN 0 WHEN 'maintenance' THEN 1\n WHEN 'unknown' THEN 2 WHEN 'degraded' THEN 3 WHEN 'partial_outage' THEN 4 WHEN 'major_outage' THEN 5 ELSE 2 END) DESC,\n source.name, component.name LIMIT 250;",
