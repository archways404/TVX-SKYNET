          "rawQuery": true,
          "rawSql": "SELECT p.name AS \"Provider\", p.category AS \"Category\", p.effective_status AS \"Status\",\n    c.collection_mode AS \"Collection\", p.stale AS \"Stale\", p.last_success_at AS \"Last successful poll\",\n    p.consecutive_failures AS \"Failures\", COALESCE(p.last_error, '') AS \"Last error\"\nFROM external_status.provider_current p JOIN external_status.source_catalog c USING (id)\nORDER BY CASE p.category WHEN 'customer-critical' THEN 0 WHEN 'carriers' THEN 1 WHEN 'crm' THEN 2\n    WHEN 'second-tier' THEN 3 ELSE 4 END, p.name;",
