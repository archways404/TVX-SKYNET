          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    source_id AS \"Source\",\n    COUNT(*) AS \"Checks\",\n    ROUND(100.0 * AVG(CASE WHEN succeeded THEN 1.0 ELSE 0.0 END), 1) AS \"Success rate\",\n    MAX(checked_at) AS \"Last check\"\nFROM external_status.poll_attempts\nWHERE $__timeFilter(checked_at)\nGROUP BY source_id\nORDER BY source_id;",
          "refId": "A"
        }
