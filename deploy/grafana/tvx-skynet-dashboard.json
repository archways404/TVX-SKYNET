          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    COALESCE(MAX(CASE effective_status\n        WHEN 'operational' THEN 0\n        WHEN 'maintenance' THEN 1\n        WHEN 'unknown' THEN 2\n        WHEN 'degraded' THEN 3\n        WHEN 'partial_outage' THEN 4\n        WHEN 'major_outage' THEN 5\n        ELSE 2\n    END), 2) AS \"External dependency status\"\nFROM external_status.provider_current;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "External dependency status",
      "type": "stat"
