      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TVX_SKYNET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH reported_status AS (\n SELECT p.effective_status AS status FROM external_status.provider_current p\n JOIN external_status.sources s USING (id)\n WHERE s.collection_mode NOT IN ('manual', 'public_advisory')\n    OR (NOT p.stale AND p.effective_status <> 'unknown')\n UNION ALL\n SELECT i.impact AS status FROM external_status.active_incidents i\n JOIN external_status.sources s ON s.id = i.provider_id\n WHERE s.enabled AND s.collection_mode <> 'public_advisory'\n)\nSELECT COALESCE(MAX(CASE status WHEN 'operational' THEN 0 WHEN 'maintenance' THEN 1\n WHEN 'unknown' THEN 2 WHEN 'degraded' THEN 3 WHEN 'partial_outage' THEN 4\n WHEN 'major_outage' THEN 5 ELSE 2 END), 2) AS \"Monitored service health\" FROM reported_status;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Monitored service health",
      "type": "stat"
    },
