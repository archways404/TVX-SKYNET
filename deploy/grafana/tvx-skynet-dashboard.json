      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TVX_SKYNET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN c.domain <> '' THEN 'https://www.google.com/s2/favicons?domain_url=https://' || c.domain || '&sz=64' END AS \"Icon\",\n    p.name AS \"Provider\", c.dependency AS \"Used for\", p.effective_status AS \"Status\",\n    CASE WHEN c.collection_mode = 'manual' AND p.last_success_at IS NULL THEN 'Awaiting report'\n         WHEN c.collection_mode = 'manual' AND p.stale THEN 'Report expired'\n         WHEN p.last_success_at IS NULL THEN 'Not checked'\n         WHEN p.stale THEN 'Stale'\n         WHEN p.consecutive_failures > 0 THEN 'Poll failing'\n         WHEN c.collection_mode = 'public_advisory' THEN 'Public info only'\n         ELSE 'Fresh' END AS \"Collection\",\n    p.last_success_at AS \"Last checked\", COALESCE(p.last_error, CASE WHEN c.collection_mode = 'public_advisory' THEN c.coverage ELSE '' END) AS \"Detail\"\nFROM external_status.provider_current p JOIN external_status.sources c USING (id)\nORDER BY CASE p.effective_status WHEN 'major_outage' THEN 5 WHEN 'partial_outage' THEN 4\n WHEN 'degraded' THEN 3 WHEN 'unknown' THEN 2 WHEN 'maintenance' THEN 1 ELSE 0 END DESC, p.name;",
