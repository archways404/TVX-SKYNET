          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH samples AS (\n SELECT o.provider_id, s.name, o.observed_at, s.stale_after_seconds,\n  LEAD(o.observed_at) OVER (PARTITION BY o.provider_id ORDER BY o.observed_at) AS next_at,\n  CASE o.status WHEN 'operational' THEN 0 WHEN 'maintenance' THEN 1 WHEN 'unknown' THEN 2\n   WHEN 'degraded' THEN 3 WHEN 'partial_outage' THEN 4 WHEN 'major_outage' THEN 5 ELSE 2 END::double precision AS value\n FROM external_status.provider_observations o JOIN external_status.sources s ON s.id = o.provider_id\n WHERE s.enabled AND s.collection_mode <> 'public_advisory' AND s.collection_mode <> 'public_advisory' AND $__timeFilter(o.observed_at)\n), states AS (\n SELECT observed_at AS \"time\", name AS metric, value FROM samples\n UNION ALL\n SELECT observed_at + stale_after_seconds * interval '1 second', name, 2::double precision\n FROM samples WHERE observed_at + stale_after_seconds * interval '1 second' < COALESCE(next_at, now())\n)\nSELECT * FROM states WHERE $__timeFilter(\"time\") ORDER BY \"time\";",
          "refId": "A"
        }
      ],
      "title": "Service history",
      "type": "state-timeline"
