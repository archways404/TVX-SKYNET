      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TVX_SKYNET}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH provider_state AS (\n    SELECT p.*, c.domain, c.collection_mode, c.dependency,\n        (SELECT COUNT(*) FROM external_status.active_incidents i WHERE i.provider_id = p.id) AS incident_count\n    FROM external_status.provider_current p\n    JOIN external_status.source_catalog c USING (id)\n), affected AS (\n    SELECT CASE WHEN domain <> '' THEN 'https://www.google.com/s2/favicons?domain_url=https://' || domain || '&sz=64' END AS \"Icon\",\n        name AS \"Provider\", category AS \"Category\", effective_status AS \"Status\", incident_count AS \"Incidents\",\n        CASE WHEN collection_mode = 'manual' AND last_success_at IS NULL THEN 'Awaiting manual report'\n             WHEN collection_mode = 'manual' AND stale THEN 'Manual report expired'\n             WHEN collection_mode = 'authenticated' AND last_success_at IS NULL THEN 'Credentials / first poll required'\n             WHEN stale THEN 'stale' WHEN consecutive_failures > 0 THEN 'failing' ELSE 'fresh' END AS \"Freshness\",\n        dependency AS \"Depends on provider for\"\n    FROM provider_state\n    WHERE effective_status <> 'operational' OR stale OR consecutive_failures > 0\n), display_rows AS (\n    SELECT * FROM affected\n    UNION ALL\n    SELECT NULL::text, 'No affected providers', ''::text, 'operational', 0::bigint, 'fresh', ''::text\n    WHERE NOT EXISTS (SELECT 1 FROM affected)\n)\nSELECT * FROM display_rows\nORDER BY CASE \"Status\" WHEN 'major_outage' THEN 5 WHEN 'partial_outage' THEN 4 WHEN 'degraded' THEN 3\n    WHEN 'unknown' THEN 2 WHEN 'maintenance' THEN 1 ELSE 0 END DESC, \"Provider\";",
          "refId": "A"
        }
      ],
      "title": "Affected providers",
      "type": "table"
    },
